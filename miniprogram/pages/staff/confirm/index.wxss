.confirm-card {
  margin-top: 16rpx;
}

.confirm-head {
  margin-bottom: 22rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.confirm-icon {
  width: 66rpx;
  height: 66rpx;
  flex: 0 0 66rpx;
}

.info-row {
  min-height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  border-bottom: 1rpx solid rgba(31, 41, 51, 0.08);
  font-size: 28rpx;
}

.info-row:last-of-type {
  border-bottom: 0;
}

.info-value {
  min-width: 0;
  color: #17212b;
  text-align: right;
  line-height: 1.45;
  word-break: break-all;
}
