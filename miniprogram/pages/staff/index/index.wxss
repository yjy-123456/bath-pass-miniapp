.denied {
  margin-top: 80rpx;
  text-align: center;
}

.denied-icon {
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto 22rpx;
  display: block;
}

.scan-box {
  position: relative;
  overflow: hidden;
  height: 392rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  border-radius: 22rpx;
  background:
    radial-gradient(circle at 20% 18%, rgba(159, 243, 232, 0.18), transparent 28%),
    linear-gradient(90deg, rgba(110, 231, 216, 0.16) 1rpx, transparent 1rpx),
    linear-gradient(rgba(110, 231, 216, 0.16) 1rpx, transparent 1rpx),
    linear-gradient(145deg, #16252b, #203138);
  background-size: auto, 68rpx 68rpx, 68rpx 68rpx, auto;
  color: #dff7f4;
  box-shadow: 0 18rpx 40rpx rgba(24, 35, 41, 0.18);
}

.scan-corners {
  position: relative;
  z-index: 1;
}

.scan-mark {
  width: 150rpx;
  height: 150rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(159, 243, 232, 0.92);
  border-radius: 20rpx;
  background: rgba(11, 30, 35, 0.46);
  box-shadow: 0 0 0 10rpx rgba(159, 243, 232, 0.06);
}

.scan-icon {
  width: 70rpx;
  height: 70rpx;
}

.scan-title {
  position: relative;
  z-index: 1;
  font-size: 32rpx;
  font-weight: 850;
}

.scan-subtitle {
  position: relative;
  z-index: 1;
  color: rgba(223, 247, 244, 0.78);
  font-size: 24rpx;
}

@keyframes scanLine {
  0% {
    transform: translateY(-72rpx);
    opacity: 0;
  }

  18% {
    opacity: 1;
  }

  100% {
    transform: translateY(132rpx);
    opacity: 0;
  }
}

.scan-line {
  position: absolute;
  left: 86rpx;
  right: 86rpx;
  top: 48%;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #9ff3e8, transparent);
  animation: scanLine 2200ms ease-in-out infinite;
}

.manual {
  margin-top: 20rpx;
}

.input {
  margin-top: 22rpx;
}

.staff-actions {
  margin-top: 20rpx;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 16rpx;
}

.action-btn {
  width: 100%;
  min-width: 0;
  height: 96rpx;
  margin: 0;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border: 1rpx solid rgba(47, 111, 115, 0.18);
  border-radius: 16rpx;
  background: #ffffff;
  color: #25635f;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.2;
}

.action-btn::after {
  border: 0;
}

.action-icon {
  width: 34rpx;
  height: 34rpx;
  flex: 0 0 34rpx;
}

.action-btn text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
