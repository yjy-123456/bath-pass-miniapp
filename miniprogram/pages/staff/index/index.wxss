.denied {
  margin-top: 80rpx;
}

.scan-box {
  height: 360rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  border-radius: 16rpx;
  background:
    linear-gradient(90deg, rgba(110, 231, 216, 0.22) 1rpx, transparent 1rpx),
    linear-gradient(rgba(110, 231, 216, 0.22) 1rpx, transparent 1rpx),
    #182329;
  background-size: 68rpx 68rpx;
  color: #dff7f4;
  font-size: 26rpx;
}

.scan-mark {
  width: 150rpx;
  height: 150rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #6ee7d8;
  border-radius: 16rpx;
  font-size: 72rpx;
  font-weight: 200;
}

.manual {
  margin-top: 20rpx;
}

.input {
  height: 82rpx;
  margin-top: 22rpx;
  padding: 0 22rpx;
  border: 1rpx solid rgba(31, 41, 51, 0.12);
  border-radius: 14rpx;
  background: #f8fafc;
  font-size: 26rpx;
}
