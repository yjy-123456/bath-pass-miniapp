.input {
  height: 82rpx;
  margin-top: 22rpx;
  padding: 0 22rpx;
  border: 1rpx solid rgba(31, 41, 51, 0.12);
  border-radius: 14rpx;
  background: #f8fafc;
  font-size: 26rpx;
}

.filters {
  margin-top: 20rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  overflow: hidden;
  border: 1rpx solid rgba(31, 41, 51, 0.1);
  border-radius: 12rpx;
}

.filters view {
  padding: 16rpx 4rpx;
  color: #66717f;
  text-align: center;
  font-size: 23rpx;
}

.filters .on {
  background: #2f6f73;
  color: #ffffff;
  font-weight: 800;
}

.results {
  margin-top: 22rpx;
}

.result-title {
  margin-bottom: 8rpx;
  font-size: 28rpx;
  font-weight: 800;
}
