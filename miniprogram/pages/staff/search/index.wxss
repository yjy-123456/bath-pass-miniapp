.search-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.search-icon {
  width: 62rpx;
  height: 62rpx;
  flex: 0 0 62rpx;
}

.input {
  margin-top: 22rpx;
}

.filters {
  margin-top: 20rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
  padding: 8rpx;
  border: 1rpx solid rgba(47, 111, 115, 0.1);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.6);
}

.filters view {
  min-width: 0;
  padding: 15rpx 4rpx;
  border-radius: 12rpx;
  color: #66717f;
  text-align: center;
  font-size: 23rpx;
  font-weight: 750;
  white-space: nowrap;
}

.filters .on {
  background: #ffffff;
  color: #25635f;
  font-weight: 800;
  box-shadow: 0 8rpx 18rpx rgba(47, 111, 115, 0.12);
}

.results {
  margin-top: 22rpx;
}

.result {
  border-color: rgba(184, 115, 51, 0.14);
  background: linear-gradient(135deg, #ffffff, #fffaf4);
}

.result-copy {
  min-width: 0;
}

.result-title {
  margin-bottom: 8rpx;
  color: #17212b;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.35;
}
