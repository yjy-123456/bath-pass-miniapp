.code-card {
  text-align: center;
}

.qr-image {
  width: 420rpx;
  height: 420rpx;
  margin: 32rpx auto 24rpx;
  border: 14rpx solid #f0f4f4;
  background: #ffffff;
}

.token {
  margin: 16rpx 0;
  padding: 14rpx;
  border-radius: 12rpx;
  background: #f4f7f7;
  color: #334155;
  font-size: 22rpx;
  word-break: break-all;
}

.timer {
  color: #b45309;
  font-size: 24rpx;
  font-weight: 750;
}
