.section {
  margin-top: 20rpx;
}

.section-title {
  margin-bottom: 14rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.detail,
.line {
  margin-top: 14rpx;
  color: #4b5563;
  font-size: 26rpx;
  line-height: 1.55;
}

.small {
  margin-bottom: 0;
  font-size: 23rpx;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.stepper button {
  width: 58rpx;
  height: 58rpx;
  border-radius: 12rpx;
  background: #edf6f4;
  color: #2f6f73;
  font-size: 34rpx;
}

.stepper button::after {
  border: 0;
}

.total {
  margin-top: 24rpx;
}

.phone-panel {
  margin-top: 26rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(198, 125, 69, 0.22);
  border-radius: 14rpx;
  background: #fff7ed;
}

.demo-phone {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(198, 125, 69, 0.18);
}

.demo-bind-row {
  margin-top: 14rpx;
  display: grid;
  grid-template-columns: 1fr 128rpx;
  gap: 14rpx;
  align-items: center;
}

.phone-input {
  height: 72rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(31, 41, 51, 0.12);
  border-radius: 12rpx;
  background: #ffffff;
  font-size: 25rpx;
}

.mini-btn {
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: #2f6f73;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 750;
}

.mini-btn::after {
  border: 0;
}
