<view class="page">
  <view class="card result">
    <view class="icon {{paid ? 'paid' : ''}}">{{paid ? '✓' : '¥'}}</view>
    <view class="title">{{paid ? '模拟支付成功' : '确认模拟支付'}}</view>
    <view class="subtle">{{message}}</view>
    <button wx:if="{{!paid}}" class="btn" bindtap="mockPay">确认支付</button>
    <button wx:if="{{paid}}" class="btn" bindtap="goCoupons">查看我的券</button>
    <button class="btn secondary" bindtap="goHome">返回套餐</button>
  </view>
</view>
