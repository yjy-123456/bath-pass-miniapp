.tabs {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
  margin-bottom: 24rpx;
  padding: 8rpx;
  border: 1rpx solid rgba(47, 111, 115, 0.1);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.62);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.72);
}

.tab-item {
  min-width: 0;
  height: 86rpx;
  padding: 10rpx 4rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  color: #66717f;
  text-align: center;
}

.tab-label {
  max-width: 100%;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tab-count {
  margin-top: 6rpx;
  min-width: 34rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(47, 111, 115, 0.08);
  color: #5e6976;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.3;
}

.tab-item.active {
  background: #ffffff;
  color: #245f63;
  box-shadow: 0 8rpx 20rpx rgba(47, 111, 115, 0.12);
}

.tab-item.active .tab-count {
  background: #e6f3ef;
  color: #245f63;
}

.coupon {
  position: relative;
  overflow: hidden;
  padding: 28rpx;
  border: 1rpx solid rgba(184, 115, 51, 0.16);
  border-radius: 18rpx;
  background:
    radial-gradient(circle at 0 50%, transparent 0, transparent 18rpx, #ffffff 19rpx),
    radial-gradient(circle at 100% 50%, transparent 0, transparent 18rpx, #ffffff 19rpx),
    linear-gradient(135deg, rgba(255, 255, 255, 0.98), rgba(255, 250, 244, 0.96));
  box-shadow: 0 14rpx 34rpx rgba(45, 55, 72, 0.08);
}

.coupon::before {
  content: "";
  position: absolute;
  top: 26rpx;
  bottom: 26rpx;
  right: 136rpx;
  border-left: 2rpx dashed rgba(184, 115, 51, 0.22);
}

.coupon-main {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.coupon-copy {
  min-width: 0;
  padding-right: 16rpx;
}

.coupon .title {
  font-size: 31rpx;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.coupon .subtle {
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.coupon-status {
  width: 112rpx;
  flex: 0 0 112rpx;
  display: flex;
  justify-content: flex-end;
}

.coupon .badge {
  max-width: 112rpx;
  padding: 8rpx 14rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

.coupon .btn {
  position: relative;
  height: 76rpx;
  margin-top: 26rpx;
  border-color: rgba(184, 115, 51, 0.28);
  border-radius: 14rpx;
  color: #9a5b24;
  font-size: 27rpx;
  box-shadow: 0 8rpx 16rpx rgba(184, 115, 51, 0.08);
}
