<view class="page">
  <view class="tabs">
    <view class="tab-item {{tab === 'unused' ? 'active' : ''}}" data-tab="unused" bindtap="switchTab">
      <view class="tab-label">未使用</view>
      <view class="tab-count">{{groups.unused.length}}</view>
    </view>
    <view class="tab-item {{tab === 'used' ? 'active' : ''}}" data-tab="used" bindtap="switchTab">
      <view class="tab-label">已使用</view>
      <view class="tab-count">{{groups.used.length}}</view>
    </view>
    <view class="tab-item {{tab === 'expired' ? 'active' : ''}}" data-tab="expired" bindtap="switchTab">
      <view class="tab-label">已过期</view>
      <view class="tab-count">{{groups.expired.length}}</view>
    </view>
  </view>

  <view wx:if="{{currentCoupons.length}}" class="stack">
    <view class="coupon fade-up" wx:for="{{currentCoupons}}" wx:key="_id">
      <view class="coupon-main">
        <view class="coupon-copy">
          <view class="title">{{item.productSnapshot.name}}</view>
          <view class="subtle">券号 {{item.couponNo}}</view>
          <view class="subtle">有效期至 {{item.validToText}}</view>
        </view>
        <view class="coupon-status">
          <text class="badge">{{item.statusText}}</text>
        </view>
      </view>
      <button wx:if="{{item.status === 'unused'}}" class="btn secondary" data-id="{{item._id}}" bindtap="showCode">查看二维码</button>
    </view>
  </view>

  <view wx:else class="empty">
    <image class="empty-icon" src="/assets/icons/coupon.svg" mode="aspectFit"></image>
    <view>暂无对应电子券</view>
  </view>
</view>
