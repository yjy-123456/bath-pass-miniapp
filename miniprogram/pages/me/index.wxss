.profile {
  margin-top: 8rpx;
}

.phone-row {
  margin-top: 28rpx;
  padding-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  border-top: 1rpx solid rgba(31, 41, 51, 0.08);
}

.label {
  color: #778391;
  font-size: 24rpx;
}

.phone {
  margin-top: 8rpx;
  color: #1f2933;
  font-size: 32rpx;
  font-weight: 800;
}

.mini-btn {
  min-width: 136rpx;
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: #2f6f73;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 750;
}

.mini-btn::after {
  border: 0;
}

.menu {
  margin-top: 22rpx;
  padding: 0 26rpx;
}

.menu-item {
  min-height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid rgba(31, 41, 51, 0.08);
  color: #1f2933;
  font-size: 29rpx;
  font-weight: 700;
}

.menu-item:last-child {
  border-bottom: 0;
}

.menu-item.staff {
  color: #2f6f73;
}

.debug {
  margin-top: 22rpx;
}

.openid {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.5;
  word-break: break-all;
}

.demo-btn {
  margin-top: 20rpx;
}
