.profile {
  margin-top: 8rpx;
  overflow: hidden;
  border-color: rgba(184, 115, 51, 0.14);
  background:
    linear-gradient(150deg, rgba(255, 247, 237, 0.96), rgba(255, 255, 255, 0.94) 58%, rgba(230, 243, 239, 0.92)),
    #ffffff;
}

.profile-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.profile-icon {
  width: 78rpx;
  height: 78rpx;
  padding: 16rpx;
  border-radius: 20rpx;
  background: rgba(47, 111, 115, 0.1);
}

.phone-row {
  margin-top: 28rpx;
  padding: 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  border: 1rpx solid rgba(47, 111, 115, 0.12);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.78);
}

.phone-copy {
  min-width: 0;
}

.label {
  color: #778391;
  font-size: 24rpx;
}

.phone {
  margin-top: 8rpx;
  color: #1f2933;
  font-size: 32rpx;
  font-weight: 850;
}

.demo-phone {
  margin-top: 20rpx;
  padding: 18rpx;
  border: 1rpx dashed rgba(184, 115, 51, 0.24);
  border-radius: 16rpx;
  background: rgba(255, 247, 237, 0.72);
}

.demo-bind-row {
  margin-top: 12rpx;
  display: flex;
  gap: 14rpx;
  align-items: center;
}

.phone-input {
  flex: 1 1 auto;
  min-width: 0;
  height: 64rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(31, 41, 51, 0.12);
  border-radius: 14rpx;
  background: #ffffff;
  font-size: 25rpx;
}

.mini-btn {
  min-width: 0;
  height: 64rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: #2f6f73;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
}

.demo-bind-row .mini-btn {
  flex: 0 0 128rpx;
}

.mini-btn::after {
  border: 0;
}

.mini-btn.secondary {
  border: 1rpx solid rgba(47, 111, 115, 0.28);
  background: #ffffff;
  color: #2f6f73;
}

.menu {
  margin-top: 22rpx;
  padding: 0 24rpx;
}

.menu-item {
  min-height: 92rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  border-bottom: 1rpx solid rgba(31, 41, 51, 0.08);
  color: #1f2933;
  font-size: 29rpx;
  font-weight: 750;
}

.menu-item text {
  flex: 1;
  min-width: 0;
}

.menu-item:last-child {
  border-bottom: 0;
}

.menu-item.staff {
  color: #25635f;
}

.menu-item.staff .menu-icon {
  background: #e6f3ef;
}

.menu-icon {
  width: 46rpx;
  height: 46rpx;
  padding: 10rpx;
  border-radius: 14rpx;
  background: #fff7ed;
}

.chevron {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.42;
}

.debug {
  margin-top: 22rpx;
  border-color: rgba(31, 41, 51, 0.06);
  background: rgba(255, 255, 255, 0.7);
  box-shadow: none;
}

.openid {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.5;
  word-break: break-all;
}

.demo-btn {
  margin-top: 20rpx;
}
