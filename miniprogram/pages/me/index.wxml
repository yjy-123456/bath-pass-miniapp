<view class="page me-page">
  <view class="card profile fade-up">
    <view class="profile-top">
      <view>
        <view class="title">我的</view>
        <view class="subtle">当前身份：{{identityText}}</view>
      </view>
      <image class="profile-icon" src="/assets/icons/profile.svg" mode="aspectFit"></image>
    </view>
    <view class="phone-row">
      <view class="phone-copy">
        <view class="label">手机号</view>
        <view class="phone">{{hasPhone ? phoneNumberMasked : '未绑定'}}</view>
      </view>
      <button class="mini-btn" hover-class="btn-hover" open-type="getPhoneNumber" bindgetphonenumber="bindPhone">
        {{hasPhone ? '换绑' : '绑定'}}
      </button>
    </view>
    <view class="demo-phone">
      <view class="label">Demo 手动绑定</view>
      <view class="demo-bind-row">
        <input class="phone-input" type="number" maxlength="11" placeholder="输入测试手机号" value="{{demoPhoneNumber}}" bindinput="onDemoPhoneInput" />
        <button class="mini-btn secondary" hover-class="btn-hover" bindtap="bindDemoPhone">{{hasPhone ? '换绑' : '绑定'}}</button>
      </view>
    </view>
  </view>

  <view class="card menu">
    <view class="menu-item" bindtap="goOrders">
      <image class="menu-icon" src="/assets/icons/order.svg" mode="aspectFit"></image>
      <text>我的订单</text>
      <image class="chevron" src="/assets/icons/chevron.svg" mode="aspectFit"></image>
    </view>
    <view class="menu-item" bindtap="goCoupons">
      <image class="menu-icon" src="/assets/icons/coupon.svg" mode="aspectFit"></image>
      <text>我的券</text>
      <image class="chevron" src="/assets/icons/chevron.svg" mode="aspectFit"></image>
    </view>
    <view class="menu-item" bindtap="callStore">
      <image class="menu-icon" src="/assets/icons/contact.svg" mode="aspectFit"></image>
      <text>联系商家</text>
      <image class="chevron" src="/assets/icons/chevron.svg" mode="aspectFit"></image>
    </view>
    <view wx:if="{{isStaff}}" class="menu-item staff" bindtap="goStaff">
      <image class="menu-icon" src="/assets/icons/staff.svg" mode="aspectFit"></image>
      <text>商家工作台</text>
      <image class="chevron" src="/assets/icons/chevron.svg" mode="aspectFit"></image>
    </view>
  </view>

  <view class="card debug">
    <view class="label">Demo 调试 openid</view>
    <view class="openid">{{openid}}</view>
    <button wx:if="{{!isStaff}}" class="btn secondary demo-btn" hover-class="btn-hover" bindtap="setDemoStaff">设为 Demo 店员</button>
  </view>
</view>
