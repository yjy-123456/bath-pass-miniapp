page {
  min-height: 100%;
  color: #1f2933;
  background: #f4f1ec;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

view,
text,
button,
input {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  line-height: 1;
}

.page {
  padding: 24rpx 24rpx 48rpx;
}

.hero {
  min-height: 248rpx;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  border-radius: 16rpx;
  color: #ffffff;
  background: linear-gradient(150deg, #2f6f73, #264653 58%, #b45309);
}

.hero-title {
  font-size: 44rpx;
  font-weight: 800;
}

.hero-subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

.notice {
  margin: 22rpx 0;
  padding: 20rpx 22rpx;
  border: 1rpx solid rgba(198, 125, 69, 0.22);
  border-radius: 14rpx;
  background: #fff7ed;
  color: #8a4b1f;
  font-size: 24rpx;
  line-height: 1.55;
}

.card {
  padding: 26rpx;
  border: 1rpx solid rgba(31, 41, 51, 0.09);
  border-radius: 16rpx;
  background: #ffffff;
}

.stack {
  display: grid;
  gap: 18rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 800;
}

.subtle {
  color: #778391;
  font-size: 24rpx;
  line-height: 1.55;
}

.price {
  color: #b45309;
  font-size: 42rpx;
  font-weight: 850;
  white-space: nowrap;
}

.btn {
  width: 100%;
  height: 84rpx;
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: #2f6f73;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 750;
}

.btn::after {
  border: 0;
}

.btn.secondary {
  border: 1rpx solid rgba(47, 111, 115, 0.28);
  background: #ffffff;
  color: #2f6f73;
}

.btn.warn {
  background: #b45309;
}

.badge {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #e6f3ef;
  color: #25635f;
  font-size: 23rpx;
  font-weight: 750;
}

.danger {
  color: #b42318;
}

.empty {
  padding: 72rpx 24rpx;
  color: #778391;
  text-align: center;
  font-size: 26rpx;
}
